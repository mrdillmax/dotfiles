/*
 * Launcher and dmenu theme.
 *
 * Colours come from colors.rasi (matugen). Rows stay transparent; only the
 * selected row gets a fill. The font must resolve Nerd Font glyphs for icons.
 */

configuration {
    modi:                       "drun,run,window";
    show-icons:                 true;
    icon-theme:                 "breeze-dark";
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    drun-display-format:        "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:              "{w} · {c} · {t}";
}

@import                         "colors.rasi"

* {
    font:                       "Inter 13";
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      620px;
    x-offset:                   0px;
    y-offset:                   0px;
    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     2px solid;
    border-radius:              14px;
    border-color:               @outline;
    cursor:                     "default";
    background-color:           @surface;
}

mainbox {
    enabled:                    true;
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    14px 18px;
    border:                     0px 0px 1px 0px;
    border-color:               @outline-variant;
    background-color:           @surface-container-high;
    text-color:                 @on-surface;
    children:                   [ "prompt", "entry" ];
}

prompt {
    enabled:                    false;
    padding:                    0px;
    background-color:           transparent;
    text-color:                 @primary;
    vertical-align:             0.5;
}

entry {
    enabled:                    true;
    padding:                    0px;
    background-color:           transparent;
    text-color:                 @on-surface;
    cursor:                     text;
    placeholder:                "Search";
    placeholder-color:          @on-surface-variant;
    vertical-align:             0.5;
}

listview {
    enabled:                    true;
    columns:                    1;
    lines:                      10;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    6px;
    margin:                     0px;
    padding:                    12px;
    border:                     0px solid;
    background-color:           transparent;
    text-color:                 @on-surface;
    cursor:                     "default";
}

scrollbar {
    handle-width:               4px;
    handle-color:               @outline;
    border-radius:              8px;
    background-color:           @surface-container;
}

element {
    enabled:                    true;
    spacing:                    12px;
    margin:                     0px;
    padding:                    10px 14px;
    border-radius:              10px;
    background-color:           transparent;
    text-color:                 @on-surface;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @on-surface;
}

element selected.normal {
    background-color:           @primary-container;
    text-color:                 @on-primary-container;
}

element selected.active {
    background-color:           @secondary-container;
    text-color:                 @on-secondary-container;
}

element selected.urgent {
    background-color:           @error-container;
    text-color:                 @on-error-container;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

message {
    enabled:                    true;
    margin:                     0px;
    padding:                    12px;
    background-color:           transparent;
    text-color:                 @on-surface;
}

textbox {
    padding:                    10px;
    border-radius:              8px;
    background-color:           @surface-container;
    text-color:                 @on-surface;
    vertical-align:             0.5;
    horizontal-align:           0.0;
    highlight:                  none;
    placeholder-color:          @on-surface-variant;
    blink:                      true;
    markup:                     true;
}

error-message {
    padding:                    12px;
    background-color:           @surface;
    text-color:                 @error;
}