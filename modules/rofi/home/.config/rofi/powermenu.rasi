configuration {
    show-icons:                 false;
}

@import                         "colors.rasi"

* {
    font:                       "Inter 12";
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      420px;
    x-offset:                   0px;
    y-offset:                   0px;
    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     2px solid;
    border-radius:              16px;
    border-color:               @outline;
    cursor:                     "default";
    background-color:           @surface;
}

mainbox {
    enabled:                    true;
    spacing:                    15px;
    margin:                     0px;
    padding:                    15px;
    border:                     0px solid;
    border-radius:              0px;
    background-color:           transparent;
    children:                   [ "message", "listview" ];
}

inputbar {
    enabled:                    true;
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px;
    border-radius:              0px;
    background-color:           transparent;
    children:                   [ "textbox-prompt-colon", "prompt"];
}

dummy {
    background-color:           transparent;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "";
    padding:                    12px 16px;
    border-radius:              10px;
    background-color:           @error;
    text-color:                 @on-error;
}

prompt {
    enabled:                    true;
    padding:                    12px;
    border-radius:              0px;
    background-color:           @on-surface;
    text-color:                 @surface;
}

message {
    enabled:                    true;
    margin:                     0px;
    padding:                    12px;
    border-radius:              10px;
    background-color:           @surface-container-high;
    text-color:                 @on-surface;
}

textbox {
    background-color:           inherit;
    text-color:                 inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    placeholder-color:          @on-surface-variant;
    blink:                      true;
    markup:                     true;
}

error-message {
    padding:                    12px;
    border:                     0px solid;
    border-radius:              0px;
    border-color:               @outline;
    background-color:           @surface;
    text-color:                 @on-surface;
}

listview {
    enabled:                    true;
    columns:                    3;
    lines:                      1;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    spacing:                    15px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              0px;
    border-color:               @outline;
    background-color:           transparent;
    text-color:                 @on-surface;
    cursor:                     "default";
}

element {
    enabled:                    true;
    spacing:                    0px;
    margin:                     0px;
    padding:                    22px 0px;
    border:                     0px;
    border-radius:              12px;
    background-color:           @surface-container-high;
    text-color:                 @on-surface;
    cursor:                     pointer;
}

element-text {
    font:                       "JetBrainsMono Nerd Font 28";
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    margin:                     0px;
    padding:                    0px;
}

element selected.normal {
    background-color:           @primary-container;
    text-color:                 @on-primary-container;
}