{
  "position": "top",
  "margin-left": 0,
  "margin-right": 0,
  "height": 44,


  
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window",
    "custom/dunst"
  ],
  
  "modules-center": [
    "group/time"
  ],
  
  "modules-right": [
    "privacy",
    "hyprland/language",
    "group/zvuk",
    "group/hardware",
    "tray"
  ],


  
  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 35,
    "rewrite": {
      "": "Hyprland",
      "kitty": "Terminal"
    },
    "separate-outputs": false
  },



  "custom/dunst": {
    "exec": "~/.config/waybar/scripts/dunst.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "dunstctl set-paused toggle && pkill -RTMIN+8 waybar",
    "tooltip": true
  },



  "group/time": {
    "modules": ["clock", "clock#simple"],
    "orientation": "horizontal"
  },
  "clock#simple": {
    "format": "{:%H:%M:%S}",
    "tooltip": false,
    "interval": 1
  },
  "clock": {
    "format": "{:L%a %d, %b %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%d-%m-%Y}"
  },



  "privacy": {
    "icon-size": 15,
    "icon-spacing": 8
  },


  
  "hyprland/language": {
    "format": "  {}",
    "format-en": "EN",
    "format-uk": "UK",
    "on-click": "hyprctl switchxkblayout all next"
  },



  "group/zvuk": {
    "orientation": "horizontal",
    "modules": ["pulseaudio#output", "pulseaudio#input"]
  },
    "pulseaudio#output": {
    "format": "{icon}  {volume}%",
    "format-muted": " ",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": " {volume}%",
    "format-source-muted": " ",
    "tooltip-format": "Bloody G521",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },



  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"]
  },
    "cpu": {
    "format": "  {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "  {percentage}%"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "   {temperatureC}°C",
    "format-critical": "   {temperatureC}°C",
    "tooltip": false
  },



  "tray": {
    "spacing": 10
  }
}
