// Waybar — status bar layout for the Hyprland session.
//
// Left:   workspaces, focused window, notification state.
// Centre: date and the 24-hour clock.
// Right:  privacy indicators, keyboard layout, volume, hardware, tray.
//
// Clicking the keyboard layout switches it. The dunst module greys out when
// notifications are paused. Module details live below the layout lists.

{
  "position": "top",
  "margin-left": 0,
  "margin-right": 0,
  "height": 44,



  // Left: workspaces, focused window, notification state.
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window",
    "custom/dunst"
  ],

  // Centre: date and the 24-hour clock.
  "modules-center": [
    "group/time"
  ],

  // Right: privacy indicators, keyboard layout, volume, hardware, tray.
  "modules-right": [
    "privacy",
    "hyprland/language",
    "group/zvuk",
    "custom/brightness",
    "custom/battery",
    "custom/network",
    "custom/units",
    "custom/update",
    "group/hardware",
    "tray"
  ],



  // Focused window. Empty titles fall back to "Hyprland"; kitty shows as
  // "Terminal" so the bar stays readable.
  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 35,
    "rewrite": {
      "": "Hyprland",
      "kitty": "Terminal"
    },
    "separate-outputs": false
  },



  // Notification state. Clicking pauses or resumes dunst and refreshes the
  // module through its realtime signal.
  "custom/dunst": {
    "exec": "~/.local/bin/waybar-dunst.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "on-click": "dunstctl set-paused toggle && pkill -RTMIN+8 waybar",
    "tooltip": true
  },



  // Battery and network are event-driven custom modules: their scripts listen
  // to udev / NetworkManager and print a new JSON line per change.
  "custom/brightness": {
    "exec": "~/.local/bin/waybar-brightness.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "brightnessctl set 5%+",
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "custom/battery": {
    "exec": "~/.local/bin/waybar-battery.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "kitty --hold sh -c 'upower -i $(upower -e | grep -m1 BAT)'"
  },
  "custom/network": {
    "exec": "~/.local/bin/waybar-network.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "sh -c 'command -v nm-connection-editor >/dev/null && nm-connection-editor || kitty --hold nmtui'"
  },

  // Failed systemd units and repository updates stay hidden until they matter.
  "custom/units": {
    "exec": "~/.local/bin/waybar-units.sh",
    "return-type": "json",
    "interval": 30,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "kitty --class dotfiles-control-center -e bash -lc 'systemctl --failed; read -rsn1'"
  },
  "custom/update": {
    "exec": "~/.local/bin/waybar-update.sh",
    "return-type": "json",
    "interval": 21600,
    "signal": 9,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "~/.local/bin/waybar-update.sh --click"
  },

  // Date and clock. The calendar appears in the tooltip.
  "group/time": {
    "modules": ["clock", "clock#simple"],
    "orientation": "horizontal"
  },
  "clock#simple": {
    "format": "{:%H:%M:%S}",
    "tooltip": false,
    "interval": 1
  },
  "clock": {
    "format": "{:L%a %d, %b %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%d-%m-%Y}"
  },



  // Screen sharing and recording indicators.
  "privacy": {
    "icon-size": 15,
    "icon-spacing": 8
  },



  // Keyboard layout. Clicking cycles every device to the next layout.
  "hyprland/language": {
    "format": "    {}",
    "format-en": "EN",
    "format-uk": "UK",
    "on-click": "hyprctl switchxkblayout all next"
  },



  // Volume. Clicking the sink or source icon mutes it; scrolling changes it.
  "group/zvuk": {
    "orientation": "horizontal",
    "modules": ["pulseaudio#output", "pulseaudio#input"]
  },
    "pulseaudio#output": {
    "format": "{icon}     {volume}%",
    "format-muted": " ",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "   {volume}%",
    "format-source-muted": " ",
    "tooltip-format": "{desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },



  // CPU, memory and package temperature. The temperature turns critical at
  // 80 C, matching the idle and fan profile.
  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "memory", "temperature"]
  },
    "cpu": {
    "format": "    {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "    {percentage}%"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "     {temperatureC}°C",
    "format-critical": "     {temperatureC}°C",
    "tooltip": false
  },



  // Status icons from other applications.
  "tray": {
    "spacing": 10
  }
}
