// Waybar — status bar layout for the Hyprland session.
//
// Left:   workspaces, focused window, notification state.
// Centre: date and the 24-hour clock.
// Right:  privacy indicators, keyboard layout, volume, hardware, tray.
//
// Clicking the keyboard layout switches it. The dunst module greys out when
// notifications are paused. Module details live below the layout lists.

{
  "position": "top",
  "margin-left": 0,
  "margin-right": 0,
  "height": 44,



  // Left: workspaces, focused window, notification state.
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window",
    "custom/dunst"
  ],

  // Centre: date and the 24-hour clock.
  "modules-center": [
    "group/time"
  ],

  // Right: privacy indicators, keyboard layout, volume, hardware, tray.
  "modules-right": [
    "privacy",
    "hyprland/language",
    "group/zvuk",
    "group/hardware",
    "group/link",
    "custom/units",
    "custom/update",
    "tray"
  ],



  // Focused window. Empty titles fall back to "Hyprland"; kitty shows as
  // "Terminal" so the bar stays readable.
  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 24,
    "rewrite": {
      "": "Hyprland",
      "kitty": "Terminal"
    },
    "separate-outputs": false
  },



  // Notification state. Polls dunstctl and inlines the output. Clicking
  // pauses or resumes dunst and refreshes the bar via signal 8.
  "custom/dunst": {
    "exec": "bash -c 'dunstctl is-paused >/dev/null 2>&1 && printf \"{\\\"text\\\":\\\"\\xf0e3\\\",\\\"class\\\":\\\"paused\\\",\\\"tooltip\\\":\\\"Notifications paused\\\"}\\n\" || printf \"{\\\"text\\\":\\\"\\xf0e3\\\",\\\"class\\\":\\\"active\\\",\\\"tooltip\\\":\\\"Notifications active\\\"}\\n\"'",
    "return-type": "json",
    "interval": 30,
    "on-click": "dunstctl set-paused toggle && pkill -RTMIN+8 waybar",
    "tooltip": true
  },



  // Battery and network are event-driven custom modules: their scripts listen
  // to udev / NetworkManager and print a new JSON line per change.
  "custom/brightness": {
    "exec": "~/.local/bin/waybar-brightness.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "~/.local/bin/brightness-adjust.sh up",
    "on-scroll-up": "~/.local/bin/brightness-adjust.sh up",
    "on-scroll-down": "~/.local/bin/brightness-adjust.sh down"
  },
  "custom/battery": {
    "exec": "~/.local/bin/waybar-battery.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true
  },
  // Active power-profiles-daemon profile. The module stays empty on machines
  // without PPD, so the same config works on desktops and laptops.
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip": true,
    "format-icons": {
      "performance": "\uf0e7",
      "balanced": "\uf24e",
      "power-saver": "\uf06c"
    }
  },
  "custom/network": {
    "exec": "~/.local/bin/waybar-network.sh",
    "return-type": "json",
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "~/.local/bin/dotfiles-control-center --wifi"
  },

  // Bluetooth stays hidden on machines without an adapter.
  "bluetooth": {
    "format": "{icon}",
    "format-icons": {
      "on": "\uf293",
      "off": "\uf294",
      "connected": "\uf293"
    },
    "format-disabled": "\uf294",
    "format-no-controller": "",
    "tooltip-format": "{controller_alias}\n{controller_address}\n{device_alias}",
    "on-click": "~/.local/bin/dotfiles-control-center --bluetooth"
  },

  // Failed systemd units and repository updates stay hidden until they matter.
  "custom/units": {
    "exec": "~/.local/bin/waybar-units.sh",
    "return-type": "json",
    "interval": 30,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "kitty --class dotfiles-control-center -e bash -lc 'systemctl --failed; read -rsn1'"
  },
  "custom/update": {
    "exec": "~/.local/bin/waybar-update.sh",
    "return-type": "json",
    "interval": 21600,
    "signal": 9,
    "hide-empty-text": true,
    "tooltip": true,
    "on-click": "~/.local/bin/waybar-update.sh --click"
  },

  // Date and clock. The calendar appears in the tooltip.
  "group/time": {
    "modules": ["clock", "clock#simple"],
    "orientation": "horizontal"
  },
  "clock#simple": {
    "format": "{:%H:%M:%S}",
    "tooltip": false,
    "interval": 1
  },
  "clock": {
    "format": "{:L%a %d %b}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%d-%m-%Y}"
  },



  // Screen sharing and recording indicators.
  "privacy": {
    "icon-size": 15,
    "icon-spacing": 5
  },



  // Keyboard layout. Clicking cycles every device to the next layout.
  "hyprland/language": {
    "format": "  {}",
    "format-en": "EN",
    "format-uk": "UK",
    "on-click": "hyprctl switchxkblayout all next"
  },



  // Volume. Clicking the sink or source icon mutes it; scrolling changes it.
  "group/zvuk": {
    "orientation": "horizontal",
    "modules": ["pulseaudio#output", "pulseaudio#input", "custom/brightness"]
  },
    "pulseaudio#output": {
    "format": "{icon}   {volume}%",
    "format-muted": " ",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "pulseaudio#input": {
    "format": "{format_source}",
    "format-source": "  {volume}%",
    "format-source-muted": " ",
    "tooltip-format": "{desc}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
  },



  // CPU, memory and package temperature. The temperature turns critical at
  // 80 C, matching the idle and fan profile.
  "group/hardware": {
    "orientation": "horizontal",
    "modules": [
      "power-profiles-daemon",
      "custom/battery",
      "cpu",
      "memory",
      "temperature"
    ]
  },
    "cpu": {
    "format": "  {usage}%",
    "tooltip": false
  },
  "memory": {
    "format": "  {percentage}%"
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "critical-threshold": 80,
    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C",
    "tooltip": false
  },
  "group/link": {
    "orientation": "horizontal",
    "modules": ["custom/network", "bluetooth"]
  },



  // Status icons from other applications.
  "tray": {
    "icon-size": 14,
    "spacing": 6
  }
}
