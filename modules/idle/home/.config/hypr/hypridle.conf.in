# Default hypridle profile — idle, lock and suspend. idle-tune.sh renders the
# active profile over this file on login and when the power source changes.
#
# Hyprland 0.57 removed the old string form of the screen-power dispatcher.
# Screen-off and suspend go through lock-screen.sh, which enforces the
# post-resume guard even if this hypridle build ignores condition_cmd.
general {
    lock_cmd = lock-screen.sh lock --from-idle
    unlock_cmd = lock-screen.sh unlocked
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = lock-screen.sh resume
    inhibit_sleep = 3
}

# Battery defaults: dim 150s, lock 300s, screen off 330s, suspend 900s.
# The first stage brightens the panel down; it must not use DPMS or the screen
# would turn off before the lock stage and flash back on.
listener {
    timeout = 150
    on-timeout = idle-dim.sh dim
    on-resume = idle-dim.sh restore
}

listener {
    timeout = 300
    on-timeout = loginctl lock-session
}

listener {
    timeout = 330
    on-timeout = lock-screen.sh screen-off
    on-resume = lock-screen.sh unlocked
    condition_cmd = lock-screen.sh can-dpms-off
}

listener {
    timeout = 900
    on-timeout = lock-screen.sh suspend
    condition_cmd = lock-screen.sh can-suspend
}
