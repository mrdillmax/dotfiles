# Shared session environment for every graphical session managed by uwsm.
# Rendered by install.sh: this file + profiles/gpu/<profile>/env.
# Format: export KEY=VALUE (one per line).

# === Wayland / toolkit integration ===
export XDG_SESSION_TYPE=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto
export QT_QPA_PLATFORM="wayland;xcb"
export CLUTTER_BACKEND=wayland
export GDK_BACKEND="wayland,x11"
export _JAVA_AWT_WM_NONREPARENTING=1
export SDL_VIDEODRIVER="wayland,x11"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_AUTO_SCREEN_SCALE_FACTOR=1

# === Apps & KDE integration ===
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_DATA_DIRS="/usr/local/share:/usr/share"
export XDG_CURRENT_DESKTOP="Hyprland"
export TERMINAL="kitty"
export QT_QPA_PLATFORMTHEME=qt6ct
