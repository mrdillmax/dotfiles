[Unit]
Description=Zirochka invitation site (production)
Documentation=file://%h/Projects/Invite/README.md

[Service]
Type=simple
WorkingDirectory=%h/Projects/Invite
ExecStart=/usr/bin/node %h/Projects/Invite/scripts/serve.mjs --port 80 --host 0.0.0.0
Restart=always
RestartSec=2
Environment=NODE_ENV=production
StandardOutput=append:/tmp/invite-server.log
StandardError=append:/tmp/invite-server.log

[Install]
WantedBy=default.target
