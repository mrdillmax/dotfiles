[config]

[templates.hyprland]
input_path = '~/.config/matugen/templates/hyprland.lua'
output_path = '~/.config/hypr/colors.lua'

[templates.firefox]
input_path = '~/.config/matugen/templates/firefox-colors.css'
output_path = '@HOME@/.config/mozilla/firefox/@FIREFOX_PROFILE_DIR@/chrome/colors.css'

[templates.kitty]
input_path = '~/.config/matugen/templates/kitty.conf'
output_path = '~/.config/kitty/themes/Matugen.conf'
post_hook = 'pkill -SIGUSR1 kitty'

[templates.dunst]
input_path = '~/.config/matugen/templates/dunstrc'
output_path = '~/.config/dunst/dunstrc'
post_hook = 'dunstctl reload'

[templates.btop]
input_path = '~/.config/matugen/templates/btop.theme'
output_path = '~/.config/btop/themes/matugen.theme'
post_hook = 'pkill -USR2 btop || true'

[templates.vesktop_midnight]
input_path = '~/.config/matugen/templates/midnight.css'
output_path = '~/.config/vesktop/themes/midnight-discord.css'

[templates.vesktop_system24]
input_path = '~/.config/matugen/templates/system24.css'
output_path = '~/.config/vesktop/themes/system24.css'

[templates.gtk3]
input_path = '~/.config/matugen/templates/gtk.css'
output_path = '~/.config/gtk-3.0/colors.css'
post_hook = 'gsettings set org.gnome.desktop.interface gtk-theme ""; gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-{{mode}}; gsettings set org.gnome.desktop.interface color-scheme prefer-{{mode}}'

[templates.gtk4]
input_path = '~/.config/matugen/templates/gtk.css'
output_path = '~/.config/gtk-4.0/colors.css'

[templates.micro]
input_path = '~/.config/matugen/templates/micro.micro'
output_path = '~/.config/micro/colorschemes/matugen.micro'

[templates.telegram]
input_path = '~/.config/matugen/templates/telegram.tdesktop-palette'
output_path = '~/.config/matugen/output/telegram.tdesktop-palette'

[templates.obsidian]
input_path = '~/.config/matugen/templates/obsidian.css'
output_path = '@HOME@/Obsidian/@OBSIDIAN_VAULT@/.obsidian/snippets/matugen.css'

[templates.qt5ct]
input_path = '~/.config/matugen/templates/qt_palette.conf'
output_path = '~/.config/qt5ct/colors/matugen.conf'

[templates.qt6ct]
input_path = '~/.config/matugen/templates/qt_palette.conf'
output_path = '~/.config/qt6ct/colors/matugen.conf'

[templates.color-scheme]
input_path = '~/.config/matugen/templates/kde_scheme.colors'
output_path = '~/.local/share/color-schemes/Matugen.colors'

[templates.spotify]
input_path = '~/.config/matugen/templates/spicetify.ini'
output_path = '~/.config/spicetify/Themes/Sleek/color.ini'
post_hook = 'spicetify apply -n'

[templates.waybar]
input_path = '~/.config/matugen/templates/waybar.css'
output_path = '~/.config/waybar/colors.css'
post_hook = 'pkill -SIGUSR2 waybar'

[templates.mpv]
input_path = '~/.config/matugen/templates/mpv.conf'
output_path = '~/.config/mpv/matugen.conf'

[templates.rofi]
input_path = '~/.config/matugen/templates/rofi.rasi'
output_path = '~/.config/rofi/colors.rasi'
