/*
 * Control Center theme.
 *
 * Same width, font and row treatment as launcher.rasi so the menus feel like
 * one surface. Rows are transparent; selection uses primary-container.
 */

@import "colors.rasi"

* {
    font:                       "Inter 13";
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    width:                      620px;
    x-offset:                   0px;
    y-offset:                   0px;
    margin:                     0px;
    padding:                    0px;
    border:                     2px solid;
    border-radius:              14px;
    border-color:               @outline;
    cursor:                     "default";
    background-color:           @surface;
}

mainbox {
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    background-color:           transparent;
    children:                   [ "inputbar", "listview" ];
}

inputbar {
    spacing:                    10px;
    margin:                     0px;
    padding:                    14px 18px;
    border:                     0px 0px 1px 0px;
    border-color:               @outline-variant;
    background-color:           @surface-container-high;
    text-color:                 @on-surface;
    children:                   [ "prompt", "entry" ];
}

prompt {
    padding:                    0px;
    background-color:           transparent;
    text-color:                 @primary;
    vertical-align:             0.5;
}

entry {
    padding:                    0px;
    background-color:           transparent;
    text-color:                 @on-surface;
    cursor:                     text;
    placeholder:                "Search";
    placeholder-color:          @on-surface-variant;
    vertical-align:             0.5;
}

listview {
    columns:                    1;
    lines:                      20;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    4px;
    margin:                     0px;
    padding:                    10px;
    border:                     0px solid;
    background-color:           transparent;
    text-color:                 @on-surface;
}

/* Rows stay flat like the launcher. Only the selected row gets a fill. */
element {
    spacing:                    12px;
    margin:                     0px;
    padding:                    10px 14px;
    border:                     0px solid;
    border-radius:              10px;
    background-color:           transparent;
    text-color:                 @on-surface;
    cursor:                     pointer;
}

element normal.normal {
    background-color:           transparent;
    text-color:                 @on-surface;
}

element alternate.normal {
    background-color:           transparent;
    text-color:                 @on-surface;
}

element selected.normal {
    background-color:           @primary-container;
    text-color:                 @on-primary-container;
}

element-icon {
    background-color:           transparent;
    text-color:                 inherit;
    size:                       28px;
    cursor:                     inherit;
}

/* Rofi 2.x paints element-text white unless the theme says otherwise. */
element-text {
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

message {
    padding:                    14px 18px;
    background-color:           transparent;
    text-color:                 @on-surface;
}

textbox {
    background-color:           transparent;
    text-color:                 @on-surface;
    placeholder-color:          @on-surface-variant;
    highlight:                  none;
    markup:                     true;
}
