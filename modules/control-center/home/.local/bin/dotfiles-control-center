#!/usr/bin/env bash
# Rofi control center for the daily settings.
#
# Installation and updates stay in install.sh. This menu calls the small
# per-feature helpers directly, so changing a setting does not run the
# installer.
set -uo pipefail

REAL_HOME="${HOME:?HOME is not set}"
THEME="$REAL_HOME/.config/rofi/control-center.rasi"
CACHE_DIR="${XDG_CACHE_HOME:-$REAL_HOME/.cache}/dotfiles/wallpaper-thumbs"

# Resolve the repository through the installed symlink. A copy without the
# repository loses only the installer shortcuts.
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SELF")/../../../../.." 2>/dev/null && pwd || true)"
if [[ -z $ROOT || ! -x $ROOT/install.sh ]]; then
    ROOT=""
fi

die() { printf 'control-center: %s\n' "$*" >&2; exit 1; }

have() {
    command -v "$1" >/dev/null 2>&1
}

notify() {
    local message="$1"
    if have dunstify; then
        dunstify -a "Control Center" "$message" >/dev/null 2>&1 || true
    elif have notify-send; then
        notify-send "Control Center" "$message" >/dev/null 2>&1 || true
    else
        printf '%s\n' "$message"
    fi
}

rofi_pick() {
    local prompt="$1"
    shift
    local -a args=(-dmenu -i -p "$prompt" -no-custom)
    [[ -r $THEME ]] && args+=(-theme "$THEME")
    rofi "${args[@]}" "$@"
}

ask_text() {
    local prompt="$1"
    local -a args=(-dmenu -i -p "$prompt" -l 0)
    [[ -r $THEME ]] && args+=(-theme "$THEME")
    printf '\n' | rofi "${args[@]}"
}

ask_confirm() {
    local prompt="$1" choice
    choice="$(printf '%s\n' Yes No | rofi_pick "$prompt")" || return 1
    [[ $choice == Yes ]]
}

host_is_laptop() {
    local chassis=""
    compgen -G "/sys/class/power_supply/BAT*" >/dev/null 2>&1 && return 0
    [[ -r /sys/class/dmi/id/chassis_type ]] && chassis="$(< /sys/class/dmi/id/chassis_type)"
    case "$chassis" in
        8|9|10|14) return 0 ;;
    esac
    return 1
}

aur_helper() {
    if have paru; then
        printf 'paru'
    elif have yay; then
        printf 'yay'
    fi
}

# yay 13 ignores --pgpfetch and imports missing keys from gpg's default
# keyserver under --noconfirm. Some kernel build keys are not served there.
AUR_GPG_FLAGS=(--gpgflags "--keyserver hkps://keyserver.ubuntu.com --keyserver hkps://pgp.surf.nl")

message() {
    local text="$1"
    if have rofi; then
        rofi -e "$text"
    else
        printf '%s\n' "$text"
    fi
}

run_terminal() {
    local command="$1"
    local workdir="${ROOT:-$REAL_HOME}"
    local script
    script="cd $(printf '%q' "$workdir") && $command; rc=\$?; printf '\n[exit %s] Press any key to close.' \"\$rc\"; read -rsn1"
    if have kitty; then
        kitty --class dotfiles-control-center -e bash -lc "$script"
    elif have x-terminal-emulator; then
        x-terminal-emulator -e bash -lc "$script"
    else
        notify "No terminal found for: $command"
    fi
}

run_and_notify() {
    local label="$1" log
    shift
    log="$(mktemp)"
    if "$@" >"$log" 2>&1; then
        notify "$label"
    else
        notify "$label failed: $(tail -n1 "$log")"
    fi
    rm -f -- "$log"
}

require_helper() {
    local helper="$1"
    if ! have "$helper"; then
        message "$helper is not installed. Install the matching module first."
        return 1
    fi
    return 0
}

wallpaper_apply() {
    local path="$1"
    if require_helper theme-menu.sh; then
        if theme-menu.sh --wallpaper "$path" --apply >/dev/null 2>&1; then
            notify "Wallpaper applied: $(basename "$path")"
        else
            notify "Wallpaper could not be applied"
        fi
    fi
}

wallpaper_page() {
    local -a dirs=(
        "$REAL_HOME/.local/share/wallpapers"
        "$REAL_HOME/Pictures"
        "$REAL_HOME/Картинки"
        "$REAL_HOME/Изображения"
    )
    local dir current image label thumb selected path
    local -a images=() labels=()
    local -A paths=()
    local index=0

    for dir in "${dirs[@]}"; do
        [[ -d $dir ]] || continue
        while IFS= read -r image; do
            images+=("$image")
        done < <(find "$dir" -maxdepth 2 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
               -o -iname '*.webp' -o -iname '*.avif' \) 2>/dev/null | sort)
    done

    if ((${#images[@]} == 0)); then
        message "No wallpapers found in ~/.local/share/wallpapers or ~/Pictures."
        return 0
    fi

    current=""
    [[ -r $REAL_HOME/.config/hypr/wallpaper.path ]] \
        && current="$(<"$REAL_HOME/.config/hypr/wallpaper.path")"

    mkdir -p -- "$CACHE_DIR" 2>/dev/null || true
    for image in "${images[@]}"; do
        label="$(basename "$image")"
        ((index++))
        [[ $image == "$current" ]] && label+=" (current)"
        if [[ -n ${paths[$label]:-} ]]; then
            label+=" ($index)"
        fi
        paths["$label"]="$image"
        labels+=("$label")
    done

    # Rofi row options: NUL, key, unit separator, value. The icon is a real
    # thumbnail, so the list shows the wallpaper before it is applied.
    local row
    for row in "${labels[@]}"; do
        image="${paths[$row]}"
        thumb="$CACHE_DIR/$(printf '%s' "$image" | sha1sum | cut -c1-12).png"
        if [[ ! -r $thumb || $image -nt $thumb ]]; then
            if have magick; then
                magick "$image" -auto-orient -thumbnail '320x180^' \
                    -gravity center -extent 320x180 "$thumb" >/dev/null 2>&1 || thumb="$image"
            else
                thumb="$image"
            fi
        fi
        printf '%s\0icon\x1f%s\n' "$row" "$thumb"
    done >"$CACHE_DIR/rows"

    selected="$(rofi_pick "Wallpaper" -show-icons <"$CACHE_DIR/rows")" || return 0
    [[ -n ${paths[$selected]:-} ]] || return 0
    wallpaper_apply "${paths[$selected]}"
}

theme_mode_page() {
    local choice
    choice="$(printf '%s\n' Dark Light Smart | rofi_pick "Theme mode")" || return 0
    case "$choice" in
        Dark)  run_and_notify "Dark theme applied" theme-menu.sh --mode dark --apply ;;
        Light) run_and_notify "Light theme applied" theme-menu.sh --mode light --apply ;;
        Smart) run_and_notify "Smart theme applied" theme-menu.sh --mode smart --apply ;;
        "") ;;
    esac
}

theme_scheme_page() {
    local -a types=()
    local choice
    mapfile -t types < <(theme-menu.sh --list-types 2>/dev/null)
    ((${#types[@]})) || { message "theme-menu.sh is not installed."; return 0; }
    choice="$(printf '%s\n' "${types[@]}" | rofi_pick "Color scheme")" || return 0
    [[ -z $choice ]] && return 0
    run_and_notify "Color scheme applied" theme-menu.sh --type "$choice" --apply
}

appearance_status() {
    local gtk icon font cursor scheme
    gtk="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null || printf 'unknown')"
    icon="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null || printf 'unknown')"
    font="$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null || printf 'unknown')"
    cursor="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null || printf 'unknown')"
    scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null || printf 'unknown')"
    message "GTK: ${gtk}

Icons: ${icon}
Font: ${font}
Cursor: ${cursor}
Color scheme: ${scheme}"
}

appearance_page() {
    local choice
    local -a items=()
    while :; do
        items=()
        if have theme-menu.sh; then
            items+=(
                "Wallpaper — choose with thumbnails"
                "Theme mode — dark, light or smart"
                "Color scheme — matugen palette"
            )
        fi
        items+=("Appearance status — fonts, icons, cursor")
        choice="$(printf '%s
' "${items[@]}" | rofi_pick "Appearance")" || return 0
        case "$choice" in
            Wallpaper*) wallpaper_page ;;
            "Theme mode"*) theme_mode_page ;;
            "Color scheme"*) theme_scheme_page ;;
            "Appearance status"*) appearance_status ;;
            "") return 0 ;;
        esac
    done
}

desktop_page() {
    local choice
    local -a items=()
    while :; do
        items=()
        if have monitor-profiles.sh; then
            items+=(
                "Monitors — status"
                "Monitors — apply the saved layout"
            )
            if host_is_laptop; then
                items+=("Dock layout — right, left, mirror or ask")
            fi
        fi
        ((${#items[@]})) || items+=("No monitor helper is installed")
        choice="$(printf '%s
' "${items[@]}" | rofi_pick "Desktop")" || return 0
        case "$choice" in
            "Monitors — status")
                require_helper monitor-profiles.sh && run_terminal "monitor-profiles.sh status"
                ;;
            "Monitors — apply"*)
                require_helper monitor-profiles.sh && run_and_notify "Monitor layout applied" monitor-profiles.sh apply
                ;;
            "Dock layout"*)
                if require_helper monitor-profiles.sh; then
                    local layout
                    layout="$(printf '%s\n' right left mirror ask | rofi_pick "Dock layout")" || continue
                    [[ -z $layout ]] && continue
                    run_and_notify "Dock layout: $layout" monitor-profiles.sh set-layout "$layout"
                fi
                ;;
            "") return 0 ;;
        esac
    done
}

input_page() {
    local choice mouse_label="Mouse — live tuner"
    local -a items=()
    host_is_laptop && mouse_label="Mouse and touchpad — live tuner"
    while :; do
        items=()
        have mouse-tune.sh && items+=("$mouse_label")
        have binds-cheatsheet.sh && items+=("Keybinds — searchable cheatsheet")
        ((${#items[@]})) || items+=("No input helper is installed")
        choice="$(printf '%s
' "${items[@]}" | rofi_pick "Input")" || return 0
        case "$choice" in
            "Mouse"*)
                require_helper mouse-tune.sh && run_terminal "mouse-tune.sh"
                ;;
            "Keybinds"*)
                if require_helper binds-cheatsheet.sh; then
                    binds-cheatsheet.sh --rofi
                fi
                ;;
            "") return 0 ;;
        esac
    done
}

session_page() {
    local choice
    local -a items=()
    while :; do
        items=()
        have autostart.sh && items+=("Autostart — choose login applications")
        if have idle-tune.sh; then
            items+=(
                "Idle — status"
                "Idle — apply the current profile"
                "Idle — configure timeouts"
                "Idle — enable or disable"
            )
        fi
        if host_is_laptop && have lid-handler.sh; then
            items+=("Lid — status")
        fi
        if have gamemode.sh; then
            items+=("Game mode — toggle" "Game mode — status")
        fi
        ((${#items[@]})) || items+=("No session helper is installed")
        choice="$(printf '%s
' "${items[@]}" | rofi_pick "Session")" || return 0
        case "$choice" in
            "Autostart"*)
                require_helper autostart.sh && autostart.sh pick
                ;;
            "Idle — status")
                require_helper idle-tune.sh && run_terminal "idle-tune.sh status"
                ;;
            "Idle — apply"*)
                require_helper idle-tune.sh && run_and_notify "Idle profile applied" idle-tune.sh apply
                ;;
            "Idle — configure"*)
                require_helper idle-tune.sh && run_terminal "idle-tune.sh configure"
                ;;
            "Idle — enable"*)
                require_helper idle-tune.sh && run_and_notify "Idle toggled" idle-tune.sh toggle
                ;;
            "Lid — status")
                require_helper lid-handler.sh && run_terminal "lid-handler.sh status"
                ;;
            "Game mode — toggle")
                require_helper gamemode.sh && run_and_notify "Game mode toggled" gamemode.sh toggle
                ;;
            "Game mode — status")
                require_helper gamemode.sh && run_terminal "gamemode.sh status"
                ;;
            "") return 0 ;;
        esac
    done
}

package_search_install() {
    local query choice helper pkg
    local -a repo=() aur=() labels=()

    query="$(ask_text "Search repositories and AUR")" || return 0
    [[ -n $query ]] || return 0

    mapfile -t repo < <(pacman -Ssq -- "$query" 2>/dev/null | head -100)
    for pkg in "${repo[@]}"; do
        labels+=("repo/$pkg")
    done

    helper="$(aur_helper)"
    if [[ -n $helper ]]; then
        mapfile -t aur < <("$helper" -Ssq -- "$query" 2>/dev/null | head -100)
        for pkg in "${aur[@]}"; do
            printf '%s\n' "${repo[@]}" | grep -Fxq -- "$pkg" && continue
            labels+=("aur/$pkg")
        done
    fi

    if ((${#labels[@]} == 0)); then
        notify "No packages found for: $query"
        return 0
    fi

    choice="$(printf '%s\n' "${labels[@]}" | rofi_pick "Install package")" || return 0
    pkg="${choice#*/}"
    case "$choice" in
        repo/*) run_terminal "sudo pacman -S --needed $(printf '%q' "$pkg")" ;;
        aur/*)
            if [[ -n $helper ]]; then
                if [[ $helper == yay ]]; then
                    run_terminal "$helper $(printf '%q ' "${AUR_GPG_FLAGS[@]}")-S --needed $(printf '%q' "$pkg")"
                else
                    run_terminal "$helper -S --needed $(printf '%q' "$pkg")"
                fi
            else
                notify "No AUR helper; install $pkg manually"
            fi
            ;;
    esac
}

package_search_installed() {
    local query choice pkg
    local -a packages=()

    query="$(ask_text "Filter installed packages")" || return 0
    [[ -n $query ]] || return 0
    mapfile -t packages < <(pacman -Qq 2>/dev/null | grep -iF -- "$query" | head -100)
    if ((${#packages[@]} == 0)); then
        notify "No installed package matches: $query"
        return 0
    fi
    choice="$(printf '%s\n' "${packages[@]}" | rofi_pick "Installed package")" || return 0
    pkg="$choice"
    run_terminal "pacman -Qi $(printf '%q' "$pkg")"
}

package_remove() {
    local query choice pkg helper
    local -a packages=()

    query="$(ask_text "Filter packages to remove")" || return 0
    [[ -n $query ]] || return 0
    mapfile -t packages < <(pacman -Qqe 2>/dev/null | grep -iF -- "$query" | head -100)
    if ((${#packages[@]} == 0)); then
        notify "No explicitly installed package matches: $query"
        return 0
    fi
    choice="$(printf '%s\n' "${packages[@]}" | rofi_pick "Remove package")" || return 0
    pkg="$choice"
    ask_confirm "Remove $pkg and its unused dependencies?" || return 0
    helper="$(aur_helper)"
    if [[ -n $helper ]]; then
        run_terminal "$helper -Rns $(printf '%q' "$pkg")"
    else
        run_terminal "sudo pacman -Rns $(printf '%q' "$pkg")"
    fi
}

system_page() {
    local choice
    local -a items=()
    while :; do
        items=(
            "Update — repository packages"
            "Update — repository and AUR"
            "Packages — search and install"
            "Packages — search installed"
            "Packages — remove"
        )
        have reflector && items+=("Update — repository mirrors (reflector)")
        if [[ -n $ROOT ]]; then
            items+=(
                "Doctor — read-only health check"
                "DNS — check the resolver chain"
                "Packages — catalog drift"
            )
        fi
        have ramcache && items+=("RAM cache — status" "RAM cache — warm configured directories")
        if [[ -n $ROOT ]]; then
            items+=(
                "Sync — files that differ from the repository"
                "Sync — unified diffs"
                "Sync — pull live changes back"
                "Restore — list and restore backups"
            )
        fi
        choice="$(printf '%s
' "${items[@]}" | rofi_pick "System")" || return 0
        case "$choice" in
            "Update — repository packages")
                run_terminal "sudo pacman -Syu"
                ;;
            "Update — repository and AUR")
                if [[ -n $(aur_helper) ]]; then
                    if [[ $(aur_helper) == yay ]]; then
                        run_terminal "yay $(printf '%q ' "${AUR_GPG_FLAGS[@]}")-Syu"
                    else
                        run_terminal "$(aur_helper) -Syu"
                    fi
                else
                    notify "No AUR helper; updating repository packages only"
                    run_terminal "sudo pacman -Syu"
                fi
                ;;
            "Update — repository mirrors (reflector)")
                if have reflector; then
                    local backup
                    backup="/etc/pacman.d/mirrorlist.bak.$(date +%Y%m%d-%H%M%S)"
                    run_terminal "sudo cp -a /etc/pacman.d/mirrorlist $(printf '%q' "$backup") && sudo reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist"
                else
                    notify "reflector is not installed"
                fi
                ;;
            "Packages — search and install")
                package_search_install
                ;;
            "Packages — search installed")
                package_search_installed
                ;;
            "Packages — remove")
                package_remove
                ;;
            "Doctor"*)
                [[ -n $ROOT ]] && run_terminal "./install.sh --doctor"
                ;;
            "DNS"*)
                if [[ -n $ROOT ]]; then
                    run_terminal "./scripts/dns-check.sh"
                fi
                ;;
            "Packages — catalog drift"*)
                if [[ -n $ROOT ]]; then
                    run_terminal "./scripts/pkg-sync.sh status"
                fi
                ;;
            "RAM cache — status")
                require_helper ramcache && run_terminal "ramcache status"
                ;;
            "RAM cache — warm"*)
                require_helper ramcache && run_terminal "ramcache warm"
                ;;
            "Sync — files"*)
                if [[ -n $ROOT ]]; then
                    run_terminal "./scripts/sync.sh status"
                fi
                ;;
            "Sync — unified"*)
                if [[ -n $ROOT ]]; then
                    run_terminal "./scripts/sync.sh diff"
                fi
                ;;
            "Sync — pull"*)
                if [[ -n $ROOT ]]; then
                    run_terminal "./scripts/sync.sh pull"
                fi
                ;;
            "Restore"*)
                [[ -n $ROOT ]] && run_terminal "./install.sh --restore"
                ;;
            "") return 0 ;;
        esac
    done
}

install_page() {
    local choice
    while :; do
        choice="$(printf '%s\n' \
            "Spicetify — backup and apply" \
            "Open the installer" \
            "Update configuration files" | rofi_pick "Install and update")" || return 0
        case "$choice" in
            "Spicetify — backup"*)
                require_helper spicetify && run_terminal "spicetify backup apply"
                ;;
            "Open the installer")
                [[ -n $ROOT ]] && run_terminal "./install.sh"
                ;;
            "Update configuration"*)
                [[ -n $ROOT ]] && run_terminal "./install.sh --sync pull"
                ;;
            "") return 0 ;;
        esac
    done
}

wifi_connect() {
    local ssid
    local -a networks=()

    if ! have nmcli; then
        notify "NetworkManager (nmcli) is not installed"
        return 0
    fi
    mapfile -t networks < <(nmcli -t -f SSID device wifi list --rescan yes 2>/dev/null |
        awk 'NF && !seen[$0]++' | head -50)
    ((${#networks[@]})) || { notify "No Wi-Fi networks found"; return 0; }
    ssid="$(printf '%s\n' "${networks[@]}" | rofi_pick "Wi-Fi network")" || return 0
    [[ -n $ssid ]] || return 0
    run_terminal "nmcli device wifi connect $(printf '%q' "$ssid") --ask"
}

wifi_page() {
    local choice connection
    while :; do
        choice="$(printf '%s\n' "Wi-Fi — connect" "Wi-Fi — disconnect" "Wi-Fi — status" |
            rofi_pick "Wi-Fi")" || return 0
        case "$choice" in
            "Wi-Fi — connect") wifi_connect ;;
            "Wi-Fi — disconnect")
                connection="$(nmcli -t -f NAME connection show --active 2>/dev/null | head -1)"
                if [[ -n $connection ]]; then
                    run_terminal "nmcli connection down $(printf '%q' "$connection")"
                else
                    notify "No active connection"
                fi
                ;;
            "Wi-Fi — status") run_terminal "nmcli device status" ;;
            "") return 0 ;;
        esac
    done
}

bluetooth_connect() {
    local choice mac
    local -a devices=()

    if ! have bluetoothctl; then
        notify "bluez (bluetoothctl) is not installed"
        return 0
    fi
    bluetoothctl --timeout 6 scan on >/dev/null 2>&1 || true
    mapfile -t devices < <(bluetoothctl devices 2>/dev/null | sed 's/^Device //')
    ((${#devices[@]})) || { notify "No Bluetooth devices found"; return 0; }
    choice="$(printf '%s\n' "${devices[@]}" | rofi_pick "Bluetooth device")" || return 0
    [[ -n $choice ]] || return 0
    mac="${choice%% *}"
    run_terminal "bluetoothctl connect $(printf '%q' "$mac")"
}

bluetooth_page() {
    local choice
    while :; do
        choice="$(printf '%s\n' "Bluetooth — on" "Bluetooth — off" "Bluetooth — connect device" \
            "Bluetooth — status" | rofi_pick "Bluetooth")" || return 0
        case "$choice" in
            "Bluetooth — on") run_terminal "bluetoothctl power on" ;;
            "Bluetooth — off") run_terminal "bluetoothctl power off" ;;
            "Bluetooth — connect"*) bluetooth_connect ;;
            "Bluetooth — status") run_terminal "bluetoothctl show" ;;
            "") return 0 ;;
        esac
    done
}

network_page() {
    local choice
    while :; do
        choice="$(printf '%s\n' "Wi-Fi — networks and status" "Bluetooth — devices and power" |
            rofi_pick "Network")" || return 0
        case "$choice" in
            Wi-Fi*) wifi_page ;;
            Bluetooth*) bluetooth_page ;;
            "") return 0 ;;
        esac
    done
}

main_menu() {
    local choice
    while :; do
        choice="$(printf '%s\n' \
            "Appearance — wallpaper, theme, fonts" \
            "Desktop — monitors and dock" \
            "Input — mouse and keybinds" \
            "Session — autostart, idle, game mode" \
            "Network — Wi-Fi and Bluetooth" \
            "System — doctor, DNS, packages, backups" \
            "Install and update — installer, Spicetify" | rofi_pick "Control Center")" || return 0
        case "$choice" in
            "Appearance"*) appearance_page ;;
            "Desktop"*) desktop_page ;;
            "Input"*) input_page ;;
            "Session"*) session_page ;;
            "Network"*) network_page ;;
            "System"*) system_page ;;
            "Install"*) install_page ;;
            "") return 0 ;;
        esac
    done
}

case "${1:-}" in
    --help|-h)
        cat <<'EOF'
Usage: dotfiles-control-center

Opens the rofi control center for daily settings. Installation and updates
stay in ./install.sh.
EOF
        ;;
    --list-actions)
        printf '%s\n' Appearance Desktop Input Session Network System "Install and update"
        ;;
    "")
        have rofi || die "rofi is not installed"
        main_menu
        ;;
    *)
        die "unknown option: $1 (see --help)"
        ;;
esac
