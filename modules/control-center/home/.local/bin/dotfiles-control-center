#!/usr/bin/env bash
# Rofi control center for daily settings.
#
# Eight top-level pages: docs, menu toggles, style, configuration, install,
# uninstall, updates and power. Installation and updates run through
# small helpers or a terminal, so this menu never edits the system silently.
set -uo pipefail

REAL_HOME="${HOME:?HOME is not set}"
CONFIG_HOME="${XDG_CONFIG_HOME:-$REAL_HOME/.config}"
THEME="$CONFIG_HOME/rofi/control-center.rasi"
CACHE_DIR="${XDG_CACHE_HOME:-$REAL_HOME/.cache}/dotfiles/wallpaper-thumbs"
STATE_DIR="${XDG_STATE_HOME:-$REAL_HOME/.local/state}/dotfiles"

# Resolve the repository through the installed symlink. A copy without the
# repository loses only the installer shortcuts.
SELF="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT="$(cd -- "$(dirname -- "$SELF")/../../../../.." 2>/dev/null && pwd || true)"
if [[ -z $ROOT || ! -x $ROOT/install.sh ]]; then
    ROOT=""
fi

die() { printf 'control-center: %s\n' "$*" >&2; exit 1; }

have() {
    command -v "$1" >/dev/null 2>&1
}

notify() {
    local message="$1"
    if have dunstify; then
        dunstify -a "Control Center" "$message" >/dev/null 2>&1 || true
    elif have notify-send; then
        notify-send "Control Center" "$message" >/dev/null 2>&1 || true
    else
        printf '%s\n' "$message"
    fi
}

# Read stdin, then size the window to the longest row. Height follows the item
# count because every dmenu call disables the fixed line count.
rofi_pick() {
    local prompt="$1"
    shift
    local input width=440 max=0 line show_icons=0 arg
    local -a args=(-dmenu -i -p "" -no-custom -no-fixed-num-lines)

    for arg in "$@"; do
        [[ $arg == -show-icons ]] && show_icons=1
    done

    input="$(mktemp)" || die "cannot create a temporary file"
    cat >"$input"
    local rows
    rows="$(wc -l <"$input")"
    if ((show_icons == 0)); then
        while IFS= read -r line; do
            ((${#line} > max)) && max=${#line}
        done <"$input"
        width=$((max * 9 + 140))
        ((width < 440)) && width=440
        ((width > 760)) && width=760
    else
        width=640
    fi

    args+=(-theme-str "window { width: ${width}px; } prompt { enabled: false; } listview { lines: 14; } entry { placeholder: \"$prompt\"; }")
    if ((show_icons == 0 && rows > 14)); then
        args+=(-theme-str 'listview { fixed-height: true; lines: 14; }')
    fi
    if [[ -r $THEME ]]; then
        args+=(-theme "$THEME")
    fi
    rofi "${args[@]}" "$@" <"$input"
    local rc=$?
    rm -f -- "$input"
    return $rc
}

# Like rofi_pick, but the rows are Pango markup and the index is returned.
# Used by the main menu so the icons can come from the Nerd Font while the
# labels stay in Inter.
rofi_index() {
    local prompt="$1"
    shift
    local input width=440 max=0 line
    local -a args=(-dmenu -i -p "" -no-custom -no-fixed-num-lines -markup-rows -format i)

    input="$(mktemp)" || die "cannot create a temporary file"
    cat >"$input"
    while IFS= read -r line; do
        line="$(sed -E 's/<[^>]+>//g' <<<"$line")"
        ((${#line} > max)) && max=${#line}
    done <"$input"
    width=$((max * 9 + 160))
    ((width < 440)) && width=440
    ((width > 760)) && width=760

    args+=(-theme-str "window { width: ${width}px; } prompt { enabled: false; } entry { placeholder: \"$prompt\"; }")
    if [[ -r $THEME ]]; then
        args+=(-theme "$THEME")
    fi
    rofi "${args[@]}" "$@" <"$input"
    local rc=$?
    rm -f -- "$input"
    return $rc
}

open_browser() {
    local target="$1"
    if have firefox; then
        (firefox --new-tab "$target" >/dev/null 2>&1 &)
    elif have xdg-open; then
        (xdg-open "$target" >/dev/null 2>&1 &)
    else
        notify "No browser found for: $target"
    fi
}

# README is rendered best by GitHub. Derive the URL from origin so the link
# follows whichever fork or account cloned the repository.
github_readme_url() {
    local remote branch repo
    [[ -n $ROOT ]] || return 1
    remote="$(git -C "$ROOT" remote get-url origin 2>/dev/null)" || return 1
    case "$remote" in
        git@github.com:*)        repo="${remote#git@github.com:}" ;;
        ssh://git@github.com/*)  repo="${remote#ssh://git@github.com/}" ;;
        https://github.com/*)    repo="${remote#https://github.com/}" ;;
        http://github.com/*)     repo="${remote#http://github.com/}" ;;
        *) return 1 ;;
    esac
    repo="${repo%.git}"
    branch="$(git -C "$ROOT" branch --show-current 2>/dev/null)"
    [[ -n $branch ]] || branch="master"
    printf 'https://github.com/%s/blob/%s/README.md\n' "$repo" "$branch"
}

open_readme() {
    local url
    if url="$(github_readme_url)"; then
        open_browser "$url"
    elif [[ -n $ROOT && -r $ROOT/README.md ]]; then
        open_browser "$ROOT/README.md"
    else
        notify "Repository README not found"
    fi
}

# Show read-only information as a normal menu list. It uses the same row
# colours as the rest of the control center, so values stay readable.
show_info() {
    local title="$1"
    shift
    local -a rows=("$@")
    rofi_index "$title" <<<"$(printf '%s\n' "${rows[@]}")" >/dev/null || true
}

# Pick a label from "icon|label" rows. The icon renders through a Nerd Font
# span while the label keeps the UI font.
pick_icon() {
    local prompt="$1"
    shift
    local -a specs=("$@") rows=() labels=()
    local spec index

    ((${#specs[@]})) || return 1
    for spec in "${specs[@]}"; do
        labels+=("${spec#*|}")
        rows+=("<span font='JetBrainsMono Nerd Font 13'>${spec%%|*}</span>  ${spec#*|}")
    done
    index="$(printf '%s\n' "${rows[@]}" | rofi_index "$prompt")" || return 1
    [[ $index =~ ^[0-9]+$ ]] || return 1
    ((index < ${#labels[@]})) || return 1
    printf '%s\n' "${labels[$index]}"
}

ask_text() {
    local prompt="$1"
    local -a args=(-dmenu -i -p "" -l 0 -no-fixed-num-lines)
    if [[ -r $THEME ]]; then
        args+=(-theme "$THEME")
    fi
    args+=(-theme-str "window { width: 520px; } prompt { enabled: false; } entry { placeholder: \"$prompt\"; }")
    printf '\n' | rofi "${args[@]}"
}

ask_confirm() {
    local prompt="$1" choice
    choice="$(printf '%s\n' Yes No | rofi_pick "$prompt")" || return 1
    [[ $choice == Yes ]]
}

host_is_laptop() {
    local chassis=""
    compgen -G "/sys/class/power_supply/BAT*" >/dev/null 2>&1 && return 0
    [[ -r /sys/class/dmi/id/chassis_type ]] && chassis="$(</sys/class/dmi/id/chassis_type)"
    case "$chassis" in
        8|9|10|14) return 0 ;;
    esac
    return 1
}

spicetify_bin() {
    if have spicetify; then
        printf 'spicetify'
    elif [[ -x $REAL_HOME/.spicetify/spicetify ]]; then
        printf '%s' "$REAL_HOME/.spicetify/spicetify"
    fi
}

aur_helper() {
    if have paru; then
        printf 'paru'
    elif have yay; then
        printf 'yay'
    fi
}

# yay 13 ignores --pgpfetch and imports missing keys from gpg's default
# keyserver under --noconfirm. Some kernel build keys are not served there.
AUR_GPG_FLAGS=(--gpgflags "--keyserver hkps://keyserver.ubuntu.com --keyserver hkps://pgp.surf.nl")

message() {
    local text="$1"
    if have rofi; then
        local -a args=(-e "$text")
        if [[ -r $THEME ]]; then
            args=(-theme "$THEME" "${args[@]}")
            args+=(-theme-str 'message { background-color: @surface; text-color: @on-surface; } textbox { background-color: transparent; text-color: @on-surface; }')
        fi
        rofi "${args[@]}"
    else
        printf '%s\n' "$text"
    fi
}

run_terminal() {
    local hold=0
    if [[ ${1:-} == --hold ]]; then
        hold=1
        shift
    fi
    local command="$1"
    local workdir="${ROOT:-$REAL_HOME}"
    local script
    script="cd $(printf '%q' "$workdir") && $command"
    if ((hold)); then
        script+="; rc=\$?; printf '\n[exit %s] Press any key to close.' \"\$rc\"; read -rsn1"
    fi
    if have kitty; then
        kitty --class dotfiles-control-center -e bash -lc "$script"
    elif have x-terminal-emulator; then
        x-terminal-emulator -e bash -lc "$script"
    else
        notify "No terminal found for: $command"
    fi
}

run_and_notify() {
    local label="$1" log
    shift
    log="$(mktemp)"
    if "$@" >"$log" 2>&1; then
        notify "$label"
    else
        notify "$label failed: $(tail -n1 "$log")"
    fi
    rm -f -- "$log"
}

require_helper() {
    local helper="$1"
    if ! have "$helper"; then
        message "$helper is not installed. Install the matching module first."
        return 1
    fi
    return 0
}

open_url() {
    local url="$1"
    if have xdg-open; then
        xdg-open "$url" >/dev/null 2>&1 || notify "Could not open $url"
    else
        notify "$url"
    fi
}

editor_command() {
    local candidate
    if [[ -n ${EDITOR:-} ]] && have "${EDITOR%% *}"; then
        printf '%s' "$EDITOR"
        return 0
    fi
    for candidate in micro nano vim vi; do
        if have "$candidate"; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    return 1
}

open_config() {
    local file="$1" editor
    if [[ ! -r $file ]]; then
        notify "Missing config: $file"
        return 0
    fi
    if ! editor="$(editor_command)"; then
        notify "No terminal editor found (set \$EDITOR)"
        return 0
    fi
    run_terminal "$editor $(printf '%q' "$file")"
}

open_config_at() {
    local target="$1" file="${1%:*}" line="${1##*:}" editor
    [[ -r $file ]] || { notify "Missing config: $file"; return 0; }
    if ! editor="$(editor_command)"; then
        notify "No terminal editor found (set \$EDITOR)"
        return 0
    fi
    run_terminal "$editor $(printf '%q' "$file") +$line"
}

edit_bind_page() {
    local target
    if ! have binds-cheatsheet.sh; then
        notify "binds-cheatsheet.sh is not installed"
        return 0
    fi
    target="$(binds-cheatsheet.sh --rofi-edit)" || return 0
    [[ -n $target ]] || return 0
    open_config_at "$target"
    if have hyprctl; then
        hyprctl reload >/dev/null 2>&1 || true
        notify "Hyprland reloaded"
    fi
    exit 0
}

# ---------------------------------------------------------------- docs -------

docs_versions() {
    local os kernel shell compositor bar launcher term total explicit
    os="$(. /etc/os-release 2>/dev/null && printf '%s' "${PRETTY_NAME:-Arch Linux}")"
    kernel="$(uname -r)"
    shell="$(fish --version 2>/dev/null | awk '{print $3}')"
    compositor="$(hyprctl version 2>/dev/null | sed -n 's/^Hyprland \([^ ]*\).*/\1/p' | head -n1)"
    bar="$(waybar --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
    launcher="$(rofi -v 2>/dev/null | sed -n 's/^Version: //p' | head -n1)"
    term="$(kitty --version 2>/dev/null | awk '{print $2}')"
    total="$(pacman -Qq 2>/dev/null | wc -l)"
    explicit="$(pacman -Qqe 2>/dev/null | wc -l)"

    show_info "Versions" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>OS</b> · ${os:--}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Kernel</b> · ${kernel:--}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Shell</b> · fish ${shell:--}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Compositor</b> · Hyprland ${compositor:--}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Status bar</b> · Waybar ${bar:--}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Launcher</b> · rofi ${launcher:--}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Terminal</b> · kitty ${term:--}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Packages</b> · ${total} installed, ${explicit} explicit"
}

docs_links() {
    local choice
    while :; do
        choice="$(pick_icon "Links" \
            $'|Arch Wiki' \
            $'|Hyprland' \
            $'|Waybar' \
            $'|Fish' \
            $'|Rofi')" || return 0
        case "$choice" in
            "Arch Wiki") open_url "https://wiki.archlinux.org/"; exit 0 ;;
            Hyprland) open_url "https://wiki.hypr.land/"; exit 0 ;;
            Waybar) open_url "https://github.com/Alexays/Waybar/wiki"; exit 0 ;;
            Fish) open_url "https://fishshell.com/docs/current/"; exit 0 ;;
            Rofi) open_url "https://github.com/davatorium/rofi/blob/next/doc/rofi-theme.5.markdown"; exit 0 ;;
            "") return 0 ;;
        esac
    done
}

docs_page() {
    local choice
    while :; do
        local -a specs=(
            $'\uf11c|Keybinds'
            $'\uf05a|Versions'
            $'\uf02d|README'
            $'\uf0c1|Links'
        )
        have hyprsysteminfo && specs+=($'\uf108|System info')
        choice="$(pick_icon "Docs" "${specs[@]}")" || return 0
        case "$choice" in
            "Keybinds")
                if have binds-cheatsheet.sh; then
                    binds-cheatsheet.sh --rofi
                else
                    message "binds-cheatsheet.sh is not installed."
                fi
                ;;
            "Versions") docs_versions ;;
            "README") open_readme; exit 0 ;;
            "Links") docs_links ;;
            "System info") (hyprsysteminfo >/dev/null 2>&1 &) ;;
            "") return 0 ;;
        esac
    done
}

# ---------------------------------------------------------------- menu -------

waybar_start() {
    if have uwsm; then
        (uwsm app -- waybar >/dev/null 2>&1 &)
    else
        (waybar >/dev/null 2>&1 &)
    fi
}

waybar_show() {
    if pgrep -x waybar >/dev/null 2>&1; then
        notify "Waybar is already running"
        return 0
    fi
    have autostart.sh && autostart.sh enable waybar >/dev/null 2>&1
    waybar_start
    notify "Waybar shown"
}

waybar_hide() {
    if ! pgrep -x waybar >/dev/null 2>&1; then
        notify "Waybar is already hidden"
        return 0
    fi
    pkill -x waybar >/dev/null 2>&1 || true
    have autostart.sh && autostart.sh disable waybar >/dev/null 2>&1
    notify "Waybar hidden"
}

waybar_restart() {
    pkill -x waybar >/dev/null 2>&1 || true
    local i
    for i in {1..30}; do
        pgrep -x waybar >/dev/null 2>&1 || break
        sleep 0.1
    done
    waybar_start
    notify "Waybar restarted"
}

notifications_label() {
    if [[ $(dunstctl is-paused 2>/dev/null) == true ]]; then
        printf 'Resume notifications'
    else
        printf 'Pause notifications'
    fi
}

idle_label() {
    if grep -q '^ENABLED=0' "$STATE_DIR/idle.conf" 2>/dev/null; then
        printf 'Enable idle'
    else
        printf 'Disable idle'
    fi
}

gamemode_label() {
    if [[ -r $STATE_DIR/gamemode.conf ]]; then
        printf 'Disable game mode'
    else
        printf 'Enable game mode'
    fi
}

notifications_toggle() {
    if ! have dunstctl; then
        notify "dunst is not installed"
        return 0
    fi
    if [[ $(dunstctl is-paused 2>/dev/null) == true ]]; then
        dunstctl set-paused false
        notify "Notifications resumed"
    else
        dunstctl set-paused true
        printf 'Notifications paused\n'
    fi
    pkill -RTMIN+8 -x waybar >/dev/null 2>&1 || true
}

screen_lock() {
    if have hyprlock; then
        hyprlock
    elif have loginctl; then
        loginctl lock-session
    else
        notify "No lock helper found"
    fi
}

menu_page() {
    local choice waybar_action="Show Waybar"
    local -a specs=()

    while :; do
        waybar_action="Show Waybar"
        pgrep -x waybar >/dev/null 2>&1 && waybar_action="Hide Waybar"
        specs=(
            $'|'"$waybar_action"
            $'|Restart Waybar'
            $'|Lock'
            $'|Reload Hyprland'
        )
        have dunstctl && specs+=($'|'"$(notifications_label)")
        have autostart.sh && specs+=($'|Autostart')
        if have idle-tune.sh; then
            specs+=(
                $'|Idle status'
                $'|Configure idle'
                $'|'"$(idle_label)"
            )
        fi
        if host_is_laptop && have lid-handler.sh; then
            specs+=($'|Lid status')
        fi
        have gamemode.sh && specs+=($'|'"$(gamemode_label)")

        choice="$(pick_icon "Menu" "${specs[@]}")" || return 0
        case "$choice" in
            "Show Waybar") waybar_show; exit 0 ;;
            "Hide Waybar") waybar_hide; exit 0 ;;
            "Restart Waybar") waybar_restart; exit 0 ;;
            "Lock") screen_lock; exit 0 ;;
            "Reload Hyprland")
                if have hyprctl; then
                    hyprctl reload >/dev/null 2>&1 && notify "Hyprland reloaded"
                else
                    notify "hyprctl is not available"
                fi
                exit 0
                ;;
            "Pause notifications"|"Resume notifications") notifications_toggle; exit 0 ;;
            "Autostart") autostart.sh pick </dev/null ;;
            "Idle status") run_terminal --hold "idle-tune.sh status"; exit 0 ;;
            "Configure idle") run_terminal "idle-tune.sh configure"; exit 0 ;;
            "Enable idle"|"Disable idle") run_terminal "idle-tune.sh toggle"; exit 0 ;;
            "Lid status") run_terminal --hold "lid-handler.sh status"; exit 0 ;;
            "Enable game mode"|"Disable game mode") run_and_notify "Game mode toggled" gamemode.sh toggle; exit 0 ;;
            "") return 0 ;;
        esac
    done
}

# --------------------------------------------------------------- style -------

wallpaper_apply() {
    local path="$1"
    if require_helper theme-menu.sh; then
        if theme-menu.sh --wallpaper "$path" --apply >/dev/null 2>&1; then
            notify "Wallpaper applied: $(basename "$path")"
        else
            notify "Wallpaper could not be applied"
        fi
    fi
}

# The theme menu writes theme.conf last, so it wins over the older
# wallpaper.path mirror. Both are read here to keep the marker accurate.
wallpaper_current_image() {
    local state="$STATE_DIR/theme.conf" image=""

    if [[ -r $state ]]; then
        image="$(sed -n 's/^wallpaper=//p' "$state" | head -n1)"
    fi
    if [[ -z $image && -r $REAL_HOME/.config/hypr/wallpaper.path ]]; then
        image="$(<"$REAL_HOME/.config/hypr/wallpaper.path")"
    fi
    [[ -n $image ]] && printf '%s\n' "$image"
}

# The label carries the "(current)" marker, so the cache key changes when the
# selection does.
wallpaper_card_key() {
    printf '%s\n%s\n' "$1" "$2"
}

rofi_color() {
    local key="$1" file="$CONFIG_HOME/rofi/colors.rasi" value
    [[ -r $file ]] || return 1
    value="$(sed -n "s/^[[:space:]]*${key}:[[:space:]]*\(#[0-9A-Fa-f][0-9A-Fa-f]*\);.*/\1/p" "$file" | head -n1)"
    [[ -n $value ]] && printf '%s' "$value"
}

# A wallpaper card: the photo on top and its name on a palette-coloured strip
# below. Rofi renders the PNG as an icon, so the caption stays under the photo.
make_wallpaper_card() {
    local image="$1" label="$2" out="$3" font
    local -a font_args=()
    font="$(fc-match -f '%{file}' Inter 2>/dev/null)"
    [[ -n $font ]] && font_args=(-font "$font")

    magick "$image" -auto-orient -thumbnail '320x180^' -gravity center -extent 320x180 \
        \( -background "$CARD_BG" -fill "$CARD_FG" "${font_args[@]}" -pointsize 13 \
           -size 320x40 -gravity center caption:"$label" \) \
        -append -depth 8 -strip "$out" >/dev/null 2>&1
}

wallpaper_page() {
    local -a dirs=(
        "$REAL_HOME/.local/share/wallpapers"
        "$REAL_HOME/Pictures"
        "$REAL_HOME/Картинки"
        "$REAL_HOME/Изображения"
    )
    local dir current image label thumb selected path
    local -a images=() labels=()
    local -A paths=()
    local index=0 card_mode=0

    for dir in "${dirs[@]}"; do
        [[ -d $dir ]] || continue
        while IFS= read -r image; do
            images+=("$image")
        done < <(find "$dir" -maxdepth 2 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
               -o -iname '*.webp' -o -iname '*.avif' \) 2>/dev/null | sort)
    done

    if ((${#images[@]} == 0)); then
        message "No wallpapers found in ~/.local/share/wallpapers or ~/Pictures."
        return 0
    fi

    current="$(wallpaper_current_image)"

    if have magick; then
        CARD_BG="$(rofi_color surface || true)"
        CARD_FG="$(rofi_color on-surface || true)"
        [[ -n $CARD_BG && -n $CARD_FG ]] && card_mode=1
    fi

    mkdir -p -- "$CACHE_DIR" 2>/dev/null || true
    for image in "${images[@]}"; do
        label="$(basename "$image")"
        ((index++))
        [[ $image == "$current" ]] && label+=" (current)"
        if [[ -n ${paths[$label]:-} ]]; then
            label+=" ($index)"
        fi
        paths["$label"]="$image"
        labels+=("$label")
    done

    # Rofi row options: NUL, key, unit separator, value. The icon is a card
    # with the name underneath when ImageMagick and a palette are available.
    local row
    for row in "${labels[@]}"; do
        image="${paths[$row]}"
        thumb="$CACHE_DIR/$(wallpaper_card_key "$row" "$image" | sha1sum | cut -c1-12).png"
        if ((card_mode)); then
            thumb="${thumb%.png}-card.png"
            if [[ ! -r $thumb || $image -nt $thumb ]]; then
                make_wallpaper_card "$image" "$row" "$thumb" || thumb="$image"
            fi
        elif [[ ! -r $thumb || $image -nt $thumb ]]; then
            magick "$image" -auto-orient -thumbnail '320x180^' \
                -gravity center -extent 320x180 "$thumb" >/dev/null 2>&1 || thumb="$image"
        fi
        printf '%s\0icon\x1f%s\n' "$row" "$thumb"
    done >"$CACHE_DIR/rows"

    local -a args=(-show-icons)
    if ((card_mode)); then
        # One card per row: two 320px cards do not fit the panel width.
        args+=(-theme-str 'window { width: 400px; } listview { lines: 3; } element-icon { size: 330px; } element-text { enabled: false; }')
    fi
    selected="$(rofi_pick "Wallpaper" "${args[@]}" <"$CACHE_DIR/rows")" || return 0
    [[ -n ${paths[$selected]:-} ]] || return 0
    wallpaper_apply "${paths[$selected]}"
    exit 0
}

theme_mode_page() {
    local choice
    choice="$(pick_icon "Theme mode" \
        $'|Dark' \
        $'|Light' \
        $'|Smart')" || return 0
    case "$choice" in
        Dark) run_and_notify "Dark theme applied" theme-menu.sh --mode dark --apply ;;
        Light) run_and_notify "Light theme applied" theme-menu.sh --mode light --apply ;;
        Smart) run_and_notify "Smart theme applied" theme-menu.sh --mode smart --apply ;;
        *) return 0 ;;
    esac
    exit 0
}

theme_scheme_page() {
    local choice type=""
    choice="$(pick_icon "Color scheme" \
        $'|Tonal spot' \
        $'|Vibrant' \
        $'|Expressive' \
        $'|Fidelity' \
        $'|Monochrome')" || return 0
    case "$choice" in
        "Tonal spot") type="scheme-tonal-spot" ;;
        Vibrant) type="scheme-vibrant" ;;
        Expressive) type="scheme-expressive" ;;
        Fidelity) type="scheme-fidelity" ;;
        Monochrome) type="scheme-monochrome" ;;
        *) return 0 ;;
    esac
    run_and_notify "Color scheme applied" theme-menu.sh --type "$type" --apply
    exit 0
}

list_fonts() {
    fc-list --format '%{family}\n' 2>/dev/null |
        tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
        awk 'NF' | sort -u
}

list_mono_fonts() {
    fc-list :spacing=mono --format '%{family}\n' 2>/dev/null |
        tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' |
        awk 'NF' | sort -u
}

list_icon_themes() {
    local dir path
    for dir in /usr/share/icons "$REAL_HOME/.local/share/icons" "$REAL_HOME/.icons"; do
        [[ -d $dir ]] || continue
        for path in "$dir"/*; do
            [[ -d $path ]] || continue
            [[ -r $path/index.theme || -d $path/cursors ]] || continue
            printf '%s\n' "${path##*/}"
        done
    done | awk '!seen[$0]++' | sort
}

list_cursor_themes() {
    local dir path
    for dir in /usr/share/icons "$REAL_HOME/.local/share/icons" "$REAL_HOME/.icons"; do
        [[ -d $dir ]] || continue
        for path in "$dir"/*; do
            [[ -d $path/cursors ]] || continue
            printf '%s\n' "${path##*/}"
        done
    done | awk '!seen[$0]++' | sort
}

list_gtk_themes() {
    local dir path
    for dir in /usr/share/themes "$REAL_HOME/.local/share/themes" "$REAL_HOME/.themes"; do
        [[ -d $dir ]] || continue
        for path in "$dir"/*; do
            [[ -d $path ]] || continue
            [[ -d $path/gtk-2.0 || -d $path/gtk-3.0 || -d $path/gtk-4.0 ]] || continue
            printf '%s\n' "${path##*/}"
        done
    done | awk '!seen[$0]++' | sort
}

set_gtk_ini() {
    local key="$1" value="$2" file
    for file in "$CONFIG_HOME/gtk-3.0/settings.ini" "$CONFIG_HOME/gtk-4.0/settings.ini"; do
        [[ -r $file ]] || continue
        if grep -q "^${key}=" "$file"; then
            sed -i "s|^${key}=.*|${key}=${value}|" "$file" 2>/dev/null || true
        else
            printf '%s=%s\n' "$key" "$value" >>"$file" 2>/dev/null || true
        fi
    done
}

apply_ui_font() {
    local family
    family="$(list_fonts | rofi_pick "UI font")" || return 1
    [[ -n $family ]] || return 1
    have gsettings && gsettings set org.gnome.desktop.interface font-name "$family 10" 2>/dev/null || true
    have gsettings && gsettings set org.gnome.desktop.interface document-font-name "$family 10" 2>/dev/null || true
    set_gtk_ini gtk-font-name "$family 10"
    notify "UI font: $family"
}

apply_mono_font() {
    local family
    family="$(list_mono_fonts | rofi_pick "Monospace font")" || return 1
    [[ -n $family ]] || return 1
    have gsettings && gsettings set org.gnome.desktop.interface monospace-font-name "$family 10" 2>/dev/null || true
    set_gtk_ini monospace-font-name "$family 10"
    notify "Monospace font: $family"
}

apply_icon_theme() {
    local theme
    theme="$(list_icon_themes | rofi_pick "Icon theme")" || return 1
    [[ -n $theme ]] || return 1
    have gsettings && gsettings set org.gnome.desktop.interface icon-theme "$theme" 2>/dev/null || true
    set_gtk_ini gtk-icon-theme-name "$theme"
    notify "Icon theme: $theme"
}

apply_cursor_theme() {
    local theme
    theme="$(list_cursor_themes | rofi_pick "Cursor theme")" || return 1
    [[ -n $theme ]] || return 1
    have gsettings && gsettings set org.gnome.desktop.interface cursor-theme "$theme" 2>/dev/null || true
    set_gtk_ini gtk-cursor-theme-name "$theme"
    notify "Cursor theme: $theme"
}

apply_gtk_theme() {
    local theme
    theme="$(list_gtk_themes | rofi_pick "GTK theme")" || return 1
    [[ -n $theme ]] || return 1
    have gsettings && gsettings set org.gnome.desktop.interface gtk-theme "$theme" 2>/dev/null || true
    set_gtk_ini gtk-theme-name "$theme"
    notify "GTK theme: $theme"
}

theme_accent_page() {
    local wallpaper index number
    local -a colors=() rows=()

    if ! have matugen || ! require_helper theme-menu.sh; then
        return 0
    fi
    wallpaper="$(theme-menu.sh --print 2>/dev/null | sed -n 's/^wallpaper=//p' | head -n1)"
    if [[ -z $wallpaper || ! -f $wallpaper ]]; then
        message "Choose a wallpaper before picking an accent colour."
        return 0
    fi

    mapfile -t colors < <(matugen image "$wallpaper" --show-source-colors 2>/dev/null |
        grep -E '^#[0-9A-Fa-f]{6}$')
    if ((${#colors[@]} == 0)); then
        message "matugen found no source colours in this wallpaper."
        return 0
    fi

    rows+=("<span font='JetBrainsMono Nerd Font 13'></span>  Automatic")
    for index in "${!colors[@]}"; do
        rows+=("<span foreground='${colors[$index]}' font='JetBrainsMono Nerd Font 13'>●</span>  Accent $((index + 1))  ${colors[$index]}")
    done

    index="$(printf '%s\n' "${rows[@]}" | rofi_index "Accent color")" || return 0
    [[ $index =~ ^[0-9]+$ ]] || return 0
    if ((index == 0)); then
        run_and_notify "Accent: automatic" theme-menu.sh --source-index auto --apply
    else
        number=$((index - 1))
        ((number < ${#colors[@]})) || return 0
        run_and_notify "Accent: ${colors[$number]}" theme-menu.sh --source-index "$number" --apply
    fi
    exit 0
}

appearance_status() {
    local gtk icon font cursor scheme
    gtk="$(gsettings get org.gnome.desktop.interface gtk-theme 2>/dev/null | tr -d "'" || printf 'unknown')"
    icon="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'" || printf 'unknown')"
    font="$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null | tr -d "'" || printf 'unknown')"
    cursor="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'" || printf 'unknown')"
    scheme="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d "'" || printf 'unknown')"

    show_info "Fonts and icons" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>GTK theme</b> · ${gtk}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Icons</b> · ${icon}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Font</b> · ${font}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Cursor</b> · ${cursor}" \
        "<span font='JetBrainsMono Nerd Font 13'></span>  <b>Color scheme</b> · ${scheme}"
}

appearance_editor() {
    if ! have nwg-look; then
        message "Install nwg-look to edit every GTK appearance setting."
        return 1
    fi
    (nwg-look >/dev/null 2>&1 &)
}

appearance_page() {
    local choice
    while :; do
        choice="$(pick_icon "Fonts and icons" \
            $'|UI font' \
            $'|Monospace font' \
            $'|Icon theme' \
            $'|Cursor theme' \
            $'|GTK theme' \
            $'|Current values' \
            $'|Appearance editor')" || return 0
        case "$choice" in
            "UI font") apply_ui_font || continue; exit 0 ;;
            "Monospace font") apply_mono_font || continue; exit 0 ;;
            "Icon theme") apply_icon_theme || continue; exit 0 ;;
            "Cursor theme") apply_cursor_theme || continue; exit 0 ;;
            "GTK theme") apply_gtk_theme || continue; exit 0 ;;
            "Current values") appearance_status ;;
            "Appearance editor") appearance_editor || continue; exit 0 ;;
            *) return 0 ;;
        esac
    done
}

style_page() {
    local choice
    while :; do
        local -a specs=(
            $'\uf03e|Wallpaper'
            $'\uf186|Theme mode'
            $'\uf1fc|Color scheme'
            $'\uf0eb|Accent color'
            $'\uf031|Fonts and icons'
        )
        have nightlight.sh && specs+=($'\uf185|Night light')
        choice="$(pick_icon "Style" "${specs[@]}")" || return 0
        case "$choice" in
            "Wallpaper") wallpaper_page ;;
            "Theme mode") theme_mode_page ;;
            "Color scheme") theme_scheme_page ;;
            "Accent color") theme_accent_page ;;
            "Fonts and icons") appearance_page ;;
            "Night light")
                nightlight.sh toggle >/dev/null 2>&1
                notify "Night light toggled"
                ;;
            "") return 0 ;;
        esac
    done
}

# --------------------------------------------------------- configuration ----

# nmcli and bluetoothctl exist whenever NetworkManager/bluez are installed, even
# on a machine without the radio. Ask the hardware, not the package.
wifi_hardware_present() {
    have nmcli || return 1
    nmcli -t -f TYPE device 2>/dev/null | grep -qx 'wifi'
}

bluetooth_hardware_present() {
    have bluetoothctl || return 1
    [[ -n $(bluetoothctl list 2>/dev/null) ]]
}

# The lock screen is opt-in: the idle module installs hyprlock. This entry is
# the explicit route; the power page keeps working without it.
lock_screen_page() {
    if have hyprlock; then
        exec hyprlock
    fi
    notify "Install hyprlock (idle module) to use the lock screen"
    return 1
}

wifi_connect() {
    local ssid
    local -a networks=()

    if ! have nmcli; then
        notify "NetworkManager (nmcli) is not installed"
        return 0
    fi
    mapfile -t networks < <(nmcli -t -f SSID device wifi list --rescan yes 2>/dev/null |
        awk 'NF && !seen[$0]++' | head -50)
    ((${#networks[@]})) || { notify "No Wi-Fi networks found"; return 0; }
    ssid="$(printf '%s\n' "${networks[@]}" | rofi_pick "Wi-Fi network")" || return 1
    [[ -n $ssid ]] || return 1
    run_terminal --hold "nmcli device wifi connect $(printf '%q' "$ssid") --ask"
}

wifi_page() {
    local choice connection
    while :; do
        choice="$(pick_icon "Wi-Fi" \
            $'|Connect' \
            $'|Disconnect' \
            $'|Status')" || return 0
        case "$choice" in
            "Connect") wifi_connect || continue; exit 0 ;;
            "Disconnect")
                connection="$(nmcli -t -f NAME connection show --active 2>/dev/null | head -1)"
                if [[ -n $connection ]]; then
                    run_terminal --hold "nmcli connection down $(printf '%q' "$connection")"
                else
                    notify "No active connection"
                fi
                exit 0
                ;;
            "Status") run_terminal --hold "nmcli device status"; exit 0 ;;
            "") return 0 ;;
        esac
    done
}

bluetooth_connect() {
    local choice mac
    local -a devices=()

    if ! have bluetoothctl; then
        notify "bluez (bluetoothctl) is not installed"
        return 0
    fi
    bluetoothctl --timeout 6 scan on >/dev/null 2>&1 || true
    mapfile -t devices < <(bluetoothctl devices 2>/dev/null | sed 's/^Device //')
    ((${#devices[@]})) || { notify "No Bluetooth devices found"; return 0; }
    choice="$(printf '%s\n' "${devices[@]}" | rofi_pick "Bluetooth device")" || return 1
    [[ -n $choice ]] || return 1
    mac="${choice%% *}"
    run_terminal --hold "bluetoothctl connect $(printf '%q' "$mac")"
}

bluetooth_page() {
    local choice
    while :; do
        choice="$(pick_icon "Bluetooth" \
            $'|Power on' \
            $'|Power off' \
            $'|Connect device' \
            $'|Status')" || return 0
        case "$choice" in
            "Power on") run_terminal --hold "bluetoothctl power on"; exit 0 ;;
            "Power off") run_terminal --hold "bluetoothctl power off"; exit 0 ;;
            "Connect device") bluetooth_connect || continue; exit 0 ;;
            "Status") run_terminal --hold "bluetoothctl show"; exit 0 ;;
            "") return 0 ;;
        esac
    done
}

monitors_page() {
    local choice layout
    local -a specs=(
        $'|Status'
        $'|Apply layout'
    )
    host_is_laptop && specs+=($'|Dock layout')
    while :; do
        choice="$(pick_icon "Monitors" "${specs[@]}")" || return 0
        case "$choice" in
            "Status") run_terminal --hold "monitor-profiles.sh status"; exit 0 ;;
            "Apply layout") run_and_notify "Monitor layout applied" monitor-profiles.sh apply; exit 0 ;;
            "Dock layout")
                layout="$(printf '%s\n' right left mirror ask | rofi_pick "Dock layout")" || return 0
                [[ -z $layout ]] && return 0
                run_and_notify "Dock layout: $layout" monitor-profiles.sh set-layout "$layout"
                exit 0
                ;;
            "") return 0 ;;
        esac
    done
}

sound_page() {
    if have hyprpwcenter; then
        (hyprpwcenter >/dev/null 2>&1 &)
    elif have pavucontrol; then
        (pavucontrol >/dev/null 2>&1 &)
    elif have wpctl; then
        run_terminal --hold "wpctl status"
    elif have pactl; then
        run_terminal --hold "pactl info"
    else
        notify "No audio control tool found"
    fi
}

tide_configure() {
    if ! have fish; then
        notify "fish is not installed"
        return 0
    fi
    if ! fish -c 'functions -q tide' >/dev/null 2>&1; then
        notify "Tide is not installed"
        return 0
    fi
    run_terminal "fish -c 'tide configure'"
}

config_files_page() {
    local -a labels=(
        "Hyprland"
        "Control center"
        "Hyprlock"
        "Hypridle"
        "Waybar layout"
        "Waybar style"
        "Fish"
        "Kitty"
        "Rofi"
        "Matugen"
    )
    local -a files=(
        "$CONFIG_HOME/hypr/hyprland.lua"
        "$CONFIG_HOME/hypr/control-center.lua"
        "$CONFIG_HOME/hypr/hyprlock.conf"
        "$CONFIG_HOME/hypr/hypridle.conf"
        "$CONFIG_HOME/waybar/config.jsonc"
        "$CONFIG_HOME/waybar/style.css"
        "$CONFIG_HOME/fish/config.fish"
        "$CONFIG_HOME/kitty/kitty.conf"
        "$CONFIG_HOME/rofi/launcher.rasi"
        "$CONFIG_HOME/matugen/config.toml"
    )
    local -a specs=()
    local choice index
    for index in "${!labels[@]}"; do
        specs+=($'|'"${labels[$index]}")
    done
    choice="$(pick_icon "Config files" "${specs[@]}")" || return 0
    [[ -z $choice ]] && return 0
    for index in "${!labels[@]}"; do
        if [[ ${labels[$index]} == "$choice" ]]; then
            open_config "${files[$index]}"
            exit 0
        fi
    done
}

configuration_page() {
    local choice mouse_label="Mouse"
    host_is_laptop && mouse_label="Mouse and touchpad"
    local -a specs=()

    while :; do
        specs=()
        { have pavucontrol || have wpctl || have pactl; } && specs+=($'|Sound')
        wifi_hardware_present && specs+=($'|Wi-Fi')
        bluetooth_hardware_present && specs+=($'|Bluetooth')
        have monitor-profiles.sh && specs+=($'|Monitors')
        have hyprlock && specs+=($'|Lock screen')
        have binds-cheatsheet.sh && specs+=($'|Keybinds')
        have mouse-tune.sh && specs+=($'|'"$mouse_label")
        have fish && specs+=($'|Tide')
        specs+=($'|Config files')
        choice="$(pick_icon "Configuration" "${specs[@]}")" || return 0
        case "$choice" in
            "Sound") sound_page; exit 0 ;;
            "Wi-Fi") wifi_page ;;
            "Bluetooth") bluetooth_page ;;
            "Monitors") monitors_page ;;
            "Lock screen") lock_screen_page ;;
            "Keybinds") edit_bind_page ;;
            Mouse*) run_terminal "mouse-tune.sh"; exit 0 ;;
            "Tide") tide_configure; exit 0 ;;
            "Config files") config_files_page ;;
            *) return 0 ;;
        esac
    done
}

# ------------------------------------------------------------- install ------

# Quote every argument for a shell string. AUR_GPG_FLAGS holds values with
# spaces, so the flags and the package list need the same treatment.
pkg_quote() {
    local out='' arg
    for arg in "$@"; do
        out+="$(printf '%q' "$arg") "
    done
    printf '%s' "${out% }"
}

# Build the install command without running it. The terminal stays attached to
# pacman/yay, so their own [Y/n] prompts keep working.
package_install_command() {   # kind helper pkg...
    local kind="$1" helper="$2"
    shift 2
    local -a cmd=()
    case "$kind" in
        repo) cmd=(sudo pacman -S --needed) ;;
        aur)
            [[ -n $helper ]] || return 1
            cmd=("$helper")
            [[ $helper == yay ]] && cmd+=("${AUR_GPG_FLAGS[@]}")
            cmd+=(-S --needed)
            ;;
        *) return 1 ;;
    esac
    printf '%s %s' "$(pkg_quote "${cmd[@]}")" "$(pkg_quote "$@")"
}

package_remove_command() {    # helper pkg
    local helper="$1" pkg="$2"
    if [[ -n $helper ]]; then
        printf '%s -Rns %s' "$helper" "$(pkg_quote "$pkg")"
    else
        printf 'sudo pacman -Rns %s' "$(pkg_quote "$pkg")"
    fi
}

# The fzf screens run in a terminal, so they return a script instead of running
# commands here. Selection is read with mapfile: piping it through xargs would
# redirect stdin from /dev/null and make pacman read EOF at its prompt.
fzf_install_script() {        # kind helper
    local kind="$1" helper="$2" source_cmd prompt preview install_cmd
    case "$kind" in
        repo)
            source_cmd='pacman -Slq'
            prompt='repo> '
            preview='pacman -Si {1}'
            install_cmd='sudo pacman -S --needed'
            ;;
        aur)
            [[ -n $helper ]] || return 1
            source_cmd="$helper -Slq"
            prompt='AUR> '
            preview="$helper -Si {1}"
            install_cmd="$helper"
            [[ $helper == yay ]] && install_cmd+=" $(pkg_quote "${AUR_GPG_FLAGS[@]}")"
            install_cmd+=" -S --needed"
            ;;
        *) return 1 ;;
    esac

    cat <<EOF
mapfile -t sel < <($source_cmd | fzf --multi --height=100% --reverse --border=rounded --info=inline --prompt='$prompt' --preview='$preview' --preview-window='down,60%,wrap')
((\${#sel[@]})) || exit 0
$install_cmd "\${sel[@]}"
EOF
}

fzf_remove_script() {         # helper
    local helper="$1" remove_cmd='sudo pacman -Rns'
    [[ -n $helper ]] && remove_cmd="$helper -Rns"

    cat <<EOF
mapfile -t sel < <(pacman -Qqe | fzf --multi --height=100% --reverse --border=rounded --info=inline --prompt='remove> ' --preview='pacman -Qi {1}' --preview-window='down,60%,wrap')
((\${#sel[@]})) || exit 0
$remove_cmd "\${sel[@]}"
EOF
}

package_search_install() {
    local query choice helper pkg
    local -a repo=() aur=() labels=()

    query="$(ask_text "Search repositories and AUR")" || return 0
    [[ -n $query ]] || return 0

    mapfile -t repo < <(pacman -Ssq -- "$query" 2>/dev/null | head -100)
    for pkg in "${repo[@]}"; do
        labels+=("repo/$pkg")
    done

    helper="$(aur_helper)"
    if [[ -n $helper ]]; then
        mapfile -t aur < <("$helper" -Ssq -- "$query" 2>/dev/null | head -100)
        for pkg in "${aur[@]}"; do
            printf '%s\n' "${repo[@]}" | grep -Fxq -- "$pkg" && continue
            labels+=("aur/$pkg")
        done
    fi

    if ((${#labels[@]} == 0)); then
        notify "No packages found for: $query"
        return 0
    fi

    choice="$(printf '%s\n' "${labels[@]}" | rofi_pick "Install package")" || return 0
    pkg="${choice#*/}"
    case "$choice" in
        repo/*)
            run_terminal --hold "$(package_install_command repo "" "$pkg")"
            ;;
        aur/*)
            if [[ -n $helper ]]; then
                run_terminal --hold "$(package_install_command aur "$helper" "$pkg")"
            else
                notify "No AUR helper; install $pkg manually"
            fi
            ;;
    esac
}

# fzf layout: package info sits below the list, so long descriptions use the
# full terminal width instead of wrapping inside a narrow side pane.
fzf_install() {
    local kind="$1" helper=""
    if ! have fzf; then
        package_search_install
        return 0
    fi

    if [[ $kind == aur ]]; then
        helper="$(aur_helper)"
        if [[ -z $helper ]]; then
            notify "No AUR helper; install paru or yay first"
            return 0
        fi
    fi
    run_terminal --hold "$(fzf_install_script "$kind" "$helper")"
}

install_page() {
    local choice
    while :; do
        local -a specs=(
            $'|Repositories'
            $'|AUR'
        )
        choice="$(pick_icon "Install" "${specs[@]}")" || return 0
        case "$choice" in
            "Repositories") fzf_install repo; exit 0 ;;
            AUR) fzf_install aur; exit 0 ;;
            *) return 0 ;;
        esac
    done
}

package_remove() {
    local query choice pkg helper
    local -a packages=()

    query="$(ask_text "Filter packages to remove")" || return 0
    [[ -n $query ]] || return 0
    mapfile -t packages < <(pacman -Qqe 2>/dev/null | grep -iF -- "$query" | head -100)
    if ((${#packages[@]} == 0)); then
        notify "No explicitly installed package matches: $query"
        return 0
    fi
    choice="$(printf '%s\n' "${packages[@]}" | rofi_pick "Remove package")" || return 0
    pkg="$choice"
    ask_confirm "Remove $pkg and its unused dependencies?" || return 0
    helper="$(aur_helper)"
    run_terminal --hold "$(package_remove_command "$helper" "$pkg")"
}

fzf_remove() {
    local helper
    if ! have fzf; then
        package_remove
        return 0
    fi
    helper="$(aur_helper)"
    run_terminal --hold "$(fzf_remove_script "$helper")"
}

fzf_inspect() {
    local script
    if ! have fzf; then
        notify "fzf is not installed"
        return 0
    fi
    script="$(cat <<'EOF'
sel="$(pacman -Qq | fzf --height=100% --reverse --border=rounded --info=inline --prompt='inspect> ' --preview='pacman -Qi {1}' --preview-window='down,60%,wrap')" || exit 0
[ -n "$sel" ] || exit 0
pacman -Qi "$sel"
EOF
)"
    run_terminal --hold "$script"
}

uninstall_page() {
    local choice
    while :; do
        choice="$(pick_icon "Uninstall" \
            $'|Remove packages' \
            $'|Inspect package')" || return 0
        case "$choice" in
            "Remove packages") fzf_remove; exit 0 ;;
            "Inspect package") fzf_inspect; exit 0 ;;
            *) return 0 ;;
        esac
    done
}

update_page() {
    local choice helper status
    while :; do
        local -a specs=()
        if have dotfiles-update-check.sh; then
            status="$(dotfiles-update-check.sh 2>/dev/null || true)"
            [[ -n $status ]] || status="cannot check (offline)"
            specs+=($'|dotfiles: '"$status")
        fi
        specs+=($'|Update repo + AUR')
        have reflector && specs+=($'|Mirrors')
        if [[ -n $ROOT ]]; then
            specs+=(
                $'|Pull repo and apply'
                $'|Apply configs'
                $'|Import live edits'
                $'|Installer'
            )
        fi
        [[ -n $(spicetify_bin) ]] && specs+=($'|Spicetify')
        choice="$(pick_icon "Update" "${specs[@]}")" || return 0
        case "$choice" in
            "dotfiles: "*)
                status="$(dotfiles-update-check.sh --refresh 2>/dev/null || true)"
                [[ -n $status ]] || status="cannot check (offline)"
                notify "dotfiles: $status"
                continue
                ;;
            "Update repo + AUR")
                helper="$(aur_helper)"
                if [[ -n $helper ]]; then
                    if [[ $helper == yay ]]; then
                        run_terminal --hold "yay $(printf '%q ' "${AUR_GPG_FLAGS[@]}")-Syu"
                    else
                        run_terminal --hold "$helper -Syu"
                    fi
                else
                    notify "No AUR helper; updating repository packages only"
                    run_terminal --hold "sudo pacman -Syu"
                fi
                exit 0
                ;;
            Mirrors)
                local backup
                backup="/etc/pacman.d/mirrorlist.bak.$(date +%Y%m%d-%H%M%S)"
                run_terminal --hold "sudo cp -a /etc/pacman.d/mirrorlist $(printf '%q' "$backup") && sudo reflector --latest 20 --protocol https --sort rate --save /etc/pacman.d/mirrorlist"
                exit 0
                ;;
            "Pull repo and apply")
                run_terminal --hold "git -C $(printf '%q' "$ROOT") pull --ff-only && ./install.sh --all --no-packages --yes"
                exit 0
                ;;
            "Apply configs") run_terminal --hold "./install.sh --all --no-packages --yes"; exit 0 ;;
            "Import live edits") run_terminal --hold "./scripts/sync.sh pull"; exit 0 ;;
            Installer) run_terminal --hold "./install.sh"; exit 0 ;;
            Spicetify) run_terminal --hold "$(spicetify_bin) backup apply"; exit 0 ;;
            "") return 0 ;;
        esac
    done
}

# ---------------------------------------------------------------- power -----

power_page() {
    if have powermenu.sh; then
        exec powermenu.sh
    else
        notify "powermenu.sh is not installed (rofi module)"
    fi
}

# ------------------------------------------------------------- main menu ----

# Main menu order. Icons line up with this list by index.
control_center_pages() {
    printf '%s\n' Docs Menu Style Configuration Install Uninstall Update Power
}

main_menu() {
    local index i
    local -a icons=($'' $'' $'' $'' $'' $'' $'' $'')
    local -a names=() rows=()

    mapfile -t names < <(control_center_pages)

    for i in "${!names[@]}"; do
        rows+=("<span font='JetBrainsMono Nerd Font 13'>${icons[$i]}</span>  ${names[$i]}")
    done

    while :; do
        index="$(printf '%s\n' "${rows[@]}" | rofi_index "Control Center")" || return 0
        case "$index" in
            0) docs_page ;;
            1) menu_page ;;
            2) style_page ;;
            3) configuration_page ;;
            4) install_page ;;
            5) uninstall_page ;;
            6) update_page ;;
            7) power_page ;;
            *) return 0 ;;
        esac
    done
}

control_center_main() {
case "${1:-}" in
    --help|-h)
        cat <<'EOF'
Usage: dotfiles-control-center

Opens the rofi control center: docs, menu toggles, style, configuration,
install, uninstall, updates and power.

Esc closes the current page. Run a single action from the installer flags
instead when scripting.
EOF
        ;;
    --list-actions)
        control_center_pages
        ;;
    "")
        have rofi || die "rofi is not installed"
        main_menu
        ;;
    *)
        die "unknown option: $1 (see --help)"
        ;;
esac
}

# Keep the script sourceable for behavior tests; only execute as a program.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    control_center_main "$@"
fi
